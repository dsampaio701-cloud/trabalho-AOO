class Livro:
    def __init__(self, idLivro, titulo, autor, isbn):
        self.idLivro = idLivro
        self.titulo = titulo
        self.autor = autor
        self.isbn = isbn
        self.statusDisponibilidade = "Disponível"
        self.emprestimos = []

    def cadastrarLivro(self):
        print("Livro cadastrado:", self.titulo)

    def consultarDisponibilidade(self):
        return self.statusDisponibilidade == "Disponível"

    def atualizarStatus(self, novoStatus):
        self.statusDisponibilidade = novoStatus

