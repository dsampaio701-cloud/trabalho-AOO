from datetime import date, timedelta


class Emprestimo:
    def __init__(self, idEmprestimo, usuario, livro):
        self.idEmprestimo = idEmprestimo
        self.usuario = usuario
        self.livro = livro
        self.dataEmprestimo = None
        self.dataDevolucaoPrevista = None
        self.dataDevolucaoReal = None
        self.status = None

    def realizarEmprestimo(self):
        if not self.livro.consultarDisponibilidade():
            raise ValueError("Livro indisponível")
        self.dataEmprestimo = date.today()
        self.dataDevolucaoPrevista = self.dataEmprestimo + timedelta(days=7)
        self.status = "Ativo"
        self.livro.atualizarStatus("Emprestado")
        self.usuario.emprestimos.append(self)
        self.livro.emprestimos.append(self)

    def registrarDevolucao(self):
        self.dataDevolucaoReal = date.today()
        self.status = "Devolvido"
        self.livro.atualizarStatus("Disponível")

