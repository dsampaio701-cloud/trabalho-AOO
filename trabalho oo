from usuario import Usuario
from livro import Livro
from emprestimo import Emprestimo

usuario = Usuario(1, "Ana", "2024001", "ana@email.com")
usuario.cadastrarUsuario()

livro = Livro(1, "Dom Casmurro", "Machado de Assis", "123456")
livro.cadastrarLivro()

emprestimo = Emprestimo(1, usuario, livro)
emprestimo.realizarEmprestimo()
print("Status do empréstimo:", emprestimo.status)
print("Livro disponível?", livro.consultarDisponibilidade())

emprestimo.registrarDevolucao()
print("Status do empréstimo:", emprestimo.status)
print("Livro disponível?", livro.consultarDisponibilidade())

