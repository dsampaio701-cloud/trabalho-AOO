class Usuario:
    def __init__(self, idUsuario, nome, matricula, email):
        self.idUsuario = idUsuario
        self.nome = nome
        self.matricula = matricula
        self.email = email
        self.emprestimos = []

    def cadastrarUsuario(self):
        print("Usuário cadastrado:", self.nome)

    def atualizarDados(self, nome, email):
        self.nome = nome
        self.email = email
